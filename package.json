{
  "name": "rigor-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "sync:docs": "node scripts/sync-rigor-docs.mjs",
    "sync:chibirigor": "node scripts/sync-chibirigor-docs.mjs",
    "sync:playground": "node scripts/sync-playground.mjs",
    "sync:api": "node scripts/sync-api-reference.mjs",
    "test:api": "node --test scripts/api-reference/*.test.mjs",
    "check:api": "node scripts/check-built-api.mjs",
    "sync:all": "pnpm run sync:docs && pnpm run sync:chibirigor && pnpm run sync:playground && pnpm run sync:api",
    "check:translations": "node scripts/check-translations.mjs",
    "bootstrap:translations": "node scripts/check-translations.mjs --bootstrap",
    "predev": "pnpm run sync:all",
    "dev": "astro dev",
    "prebuild": "pnpm run sync:all",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "github-slugger": "2.0.0",
    "remark-cjk-friendly": "^2.3.4",
    "starlight-sidebar-topics": "^0.9.0",
    "zard-doc-astro": "file:vendor/zard-doc-astro-0.0.0.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "hast-util-from-html": "2.1.0",
    "typescript": "6.0.3",
    "wrangler": "^4.162.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "shiki": ">=4.4.0"
    }
  }
}
